# ===== 템플릿 — 실제 값을 여기 넣지 말고 .env.local 에 넣으세요 (git 제외됨) =====

# ===== 데이터베이스 (Supabase 권장) =====
# Supabase 프로젝트 대시보드 상단 [Connect] 버튼 → Connection string → Transaction pooler(포트 6543) 복사
# 주의: 비밀번호에 특수문자가 있으면 URI 인코딩 필요 — '@' → '%40' 등
# 예: postgresql://postgres.xxx:MyPass%40123@aws-0-ap-northeast-2.pooler.supabase.com:6543/postgres
DATABASE_URL=

# ===== 크론 보안 =====
# 랜덤 문자열로 설정. Vercel Cron 이 이 값을 Bearer 토큰으로 자동 첨부하며
# /api/cron/collect_all 은 이 값이 일치할 때만 실행됨.
# 생성 예: python -c "import secrets; print(secrets.token_urlsafe(32))"
CRON_SECRET=

# ===== 네이버 Search API (로밍 뉴스 수집) =====
# https://developers.naver.com/apps/#register 에서 애플리케이션 등록 후 발급
# API 유형: '검색 API', 서비스 환경: '웹 애플리케이션'
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
